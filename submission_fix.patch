 grader.py      |  3 +++
 graders.py     |  3 +++
 openenv.yaml   | 39 +++++++++++++++++++++++++++++++++++----
 src/graders.py | 22 ++++++++++++++++++++++
 src/models.py  |  9 ++++++---
 src/tasks.py   | 47 ++++++++++++++++++++++++++++++++++++++---------
 7 files changed, 123 insertions(+), 16 deletions(-)
 create mode 100644 .gitignore
 create mode 100644 grader.py
 create mode 100644 graders.py
 create mode 100644 src/graders.py

diff --git a/.gitignore b/.gitignore
